{
  // The admin dashboard, type-checked under the same strict flags as the app.
  // It is NOT part of tsconfig.app.json's project (which only includes src/),
  // so `npm run build:admin` runs this explicitly before the Vite build.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.admin.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Paths — mirrors vite.admin.config.ts. src/native/** is deliberately
       unreachable from here: the admin bundle must never pull in the engine. */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@admin/*": ["./admin/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["admin"]
}
