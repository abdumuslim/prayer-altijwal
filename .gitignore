# Dependencies / build output
node_modules/
dist/
build/
*.tsbuildinfo
# Admin dashboard bundle (separate Vite app; `dist/` above doesn't match it).
client/dist-admin/

# Secrets & local-only ops (NEVER commit)
.env
.env.*
!.env.example
docs/OPERATIONS.md
CLAUDE.md

# Local SSH/debug scratch
ssh_out.txt
ssh_deploy*.txt
*.log
scratch-*.xml

# Session screenshots / browser-automation artifacts at the repo ROOT only
# (kept on disk, never committed). Nested app assets are unaffected.
/*.png
/.playwright-mcp/

# Bundled GeoNames dataset IS committed (the Docker image copies it directly;
# a clean clone must build without network). Regenerate with `npm run build:cities`.
# Only the raw download artifact stays out:
server/data/_raw/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
