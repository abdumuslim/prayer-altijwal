# prayer.altijwal.com — environment (real values live ONLY in the VPS .env, never committed)

# Postgres on the shared PG16 instance, dedicated `prayer` database.
DATABASE_URL=postgresql://USER:PASSWORD@rag-postgres-1:5432/prayer

# Web-push VAPID keys — generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@altijwal.com

# Google Places API (New) key — nearest-masjid proxy (/api/places/masjids).
# OPTIONAL: absent ⇒ feature reports disabled, client hides the section.
GOOGLE_MAPS_API_KEY=

# Maps EMBED API key — browser-visible, Embed-API-restricted. NEVER the Places key.
# OPTIONAL: absent ⇒ masjid rows expand with the deep-link buttons and no map.
GOOGLE_MAPS_EMBED_KEY=

# Self-imposed monthly ceiling on PAID upstream work, in UNITS (ADR-014):
# a live masjid search = 1 unit (1 Places call), an on-expand travel lookup = 2
# (2 Routes elements). A unit is never cheaper than the SKU it buys, so this one
# number bounds BOTH free tiers: 4500 units ⇒ ≤4500 Places calls (free 5000) and
# ≤4500 Routes elements (free 10000), whatever the mix. Default 4500.
# PLACES_MONTHLY_UNIT_CAP=4500

# Gates GET /api/places/usage (budget/telemetry view). Absent ⇒ that route 404s.
# Min 16 chars.
# ADMIN_TOKEN=

# ── Admin dashboard at /admin (docs/ADMIN_DASHBOARD.md) ──────────────────────
# NOTE: Docker Compose interpolates '$' inside env_file values, so a value
# containing '$' arrives at the container mangled. Keep values '$'-free (the
# password digest uses ':' separators for exactly this reason) or escape as '$$'.
# Operator password digest. Generate with:
#   cd server && node scripts/hash-admin-password.mjs      (reads the password
#   from stdin so it never lands in shell history; prints the line to paste)
# Absent ⇒ the whole /api/admin tree 404s and the dashboard is unusable.
# ADMIN_PASSWORD_HASH=
#
# HMAC key for the admin session cookie, ≥32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Absent ⇒ a random key per boot ⇒ you are logged out on every redeploy.
# ADMIN_SESSION_SECRET=

# ── Anonymous audience telemetry (ADR-016) ───────────────────────────────────
# HMAC key for the DAILY-ROTATING install hash, ≥16 chars (generate as above).
# Absent ⇒ POST /api/telemetry/ping still answers 204 but stores nothing.
# Rotating this key makes every previously stored day mutually unlinkable.
# TELEMETRY_SALT=
# TELEMETRY_RETENTION_DAYS=180
# Server-side clamp on stored ping precision, in degrees (0.01 ≈ 1.1 km). The
# client already rounds before sending; this stops a modified client storing
# anything finer. LOWERING IT IS A PRIVACY-POLICY + PLAY DATA-SAFETY CHANGE.
# TELEMETRY_PRECISION_DEG=0.01

# ── Play Console stats (optional, admin dashboard only) ──────────────────────
# Google service-account JSON, bind-mounted at runtime — never in the image.
# PLAY_SA_KEY_FILE=/run/secrets/play-sa.json
# PLAY_PACKAGE_NAME=com.altijwal.prayer
# Bulk-report bucket (installs/ratings live only here, not in the Reporting
# API). Play Console → Download reports → "Copy Cloud Storage URI".
# PLAY_REPORTS_BUCKET=

# Production fail-fast requires DATABASE_URL + VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY.
NODE_ENV=production
# PORT=8000
# LOG_LEVEL=info
