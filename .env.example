# prayer.altijwal.com — environment (real values live ONLY in the VPS .env, never committed)

# Postgres on the shared PG16 instance, dedicated `prayer` database.
DATABASE_URL=postgresql://USER:PASSWORD@rag-postgres-1:5432/prayer

# Web-push VAPID keys — generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@altijwal.com

# Google Places API (New) key — nearest-masjid proxy (/api/places/masjids).
# OPTIONAL: absent ⇒ feature reports disabled, client hides the section.
GOOGLE_MAPS_API_KEY=

# Production fail-fast requires DATABASE_URL + VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY.
NODE_ENV=production
# PORT=8000
# LOG_LEVEL=info
